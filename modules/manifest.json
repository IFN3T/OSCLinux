{
  "schema_version": 1,
  "modules": [
    {
      "id": "audio_player",
      "name": "Lecteur Audio",
      "description": "Affiche les informations du lecteur média choisi parmi ceux détectés par playerctl.",
      "author": "OSCLinux",
      "version": "1.0.1",
      "sha256": "e273153ae26ece916901fcb1d963e88a6b2d1f40a1c08f171d8c0dc78bb5c923",
      "settings": [
        {
          "key": "player",
          "label": "Lecteur",
          "type": "player",
          "default": "spotify"
        },
        {
          "key": "format",
          "label": "Format",
          "type": "choice",
          "choices": [
            "Titre + Artiste + Progression",
            "Titre + Artiste",
            "Artiste + Titre"
          ],
          "default": "Titre + Artiste + Progression"
        },
        {
          "key": "hide_paused",
          "label": "Masquer pendant la pause",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "id": "system",
      "name": "Indicateur de Performance",
      "description": "Affiche l’utilisation du CPU, de la RAM et de chaque GPU NVIDIA.",
      "author": "OSCLinux",
      "version": "1.2.0",
      "sha256": "e31c9feb6157316417b836c4924c237891d192a543120ddf6652756219cd6935",
      "settings": [
        {
          "key": "cpu",
          "label": "CPU",
          "type": "boolean",
          "default": true
        },
        {
          "key": "ram",
          "label": "RAM",
          "type": "boolean",
          "default": true
        },
        {
          "key": "gpu",
          "label": "GPU NVIDIA",
          "type": "boolean",
          "default": true
        }
      ]
    },
    {
      "id": "temperatures",
      "name": "Températures",
      "description": "Températures moyennes du CPU et de la RAM, de chaque GPU NVIDIA et des autres capteurs.",
      "author": "OSCLinux",
      "version": "1.3.1",
      "sha256": "afe0992e5766e48650ab38854519a07e59904303e3e40191f6548052d4c4d4da",
      "settings": [
        {
          "key": "cpu",
          "label": "CPU",
          "type": "boolean",
          "default": true
        },
        {
          "key": "ram",
          "label": "RAM",
          "type": "boolean",
          "default": true
        },
        {
          "key": "gpu",
          "label": "GPU NVIDIA",
          "type": "boolean",
          "default": true
        },
        {
          "key": "other",
          "label": "Autres capteurs",
          "type": "boolean",
          "default": false
        }
      ]
    },
    {
      "id": "weather",
      "name": "Météo",
      "description": "Conditions météo actuelles pour une ville.",
      "author": "OSCLinux",
      "version": "1.0.0",
      "sha256": "c84ad320780c0b66d6d0241385c7cc44c1798bf44c8d46e4b65e511e4a68ebd4",
      "settings": [
        {
          "key": "city",
          "label": "Ville",
          "type": "text",
          "default": "Paris"
        },
        {
          "key": "unit",
          "label": "Unités",
          "type": "choice",
          "choices": [
            "°C",
            "°F"
          ],
          "default": "°C"
        }
      ]
    },
    {
      "id": "clock",
      "name": "Horloge",
      "description": "Heure locale au format 12 h ou 24 h.",
      "author": "OSCLinux",
      "version": "1.0.0",
      "sha256": "283bcdefcdf5dca7c9ec68c7abf6695c00228860a04685d02c178320481d9848",
      "settings": [
        {
          "key": "format",
          "label": "Format horaire",
          "type": "choice",
          "choices": [
            "24h",
            "12h"
          ],
          "default": "24h"
        }
      ]
    },
    {
      "id": "custom",
      "name": "Personnalisé",
      "description": "Texte libre avec les variables {time}, {date} et {city}.",
      "author": "OSCLinux",
      "version": "1.0.0",
      "sha256": "4b61b15394a45895e8fb3041ea0250735868ac60545b2e6e4768b2d915e157c4",
      "settings": [
        {
          "key": "message",
          "label": "Message",
          "type": "text",
          "default": "♫ Bonne journée !"
        }
      ]
    }
  ]
}
